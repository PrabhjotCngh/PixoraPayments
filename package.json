{
  "name": "pixorapayments",
  "version": "1.1.0",
  "description": "Photobooth Payment Launcher with Cashfree UPI Integration",
  "main": "frontend/main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder",
    "build:win": "electron-builder --win",
    "dist": "electron-builder",
    "dev": "concurrently \"node backend/server.js\" \"electron .\"",
    "server": "node backend/server.js",
    "bridge:client": "node backend/bridge/windows-client.js",
    "bridge:localClient": "node backend/bridge/windows-clientV1.js",
    "build:bridge": "pkg backend/bridge/windows-clientV1.js --targets node18-win-x64 --output dist/PixoraBridge.exe"
  },
  "keywords": [
    "photobooth",
    "cashfree",
    "electron",
    "photorooms"
  ],
  "author": "Pixora Photorooms",
  "license": "MIT",
  "build": {
    "appId": "com.pixora.photorooms",
    "productName": "PixoraPayments",
    "files": [
      "frontend/**",
      "backend/**",
      "config.json",
      "package.json"
    ],
    "extraResources": [
      "frontend/assets/**"
    ],
    "directories": {
      "buildResources": "assets/build"
    },
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "dependencies": {
    "axios": "^1.13.2",
    "cashfree-pg": "^5.1.0",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "pg": "^8.16.3",
    "uuid": "^13.0.0",
    "ws": "^8.14.2"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "electron": "^39.2.6",
    "electron-builder": "^26.0.12",
    "pkg": "^5.8.1"
  },
  "pkg": {
    "assets": [
      "backend/bridge/bridge-config.default.env"
    ],
    "outputPath": "dist"
  }
}
