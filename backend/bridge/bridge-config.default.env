# Pixora Bridge Configuration
# Copy this file to bridge-config.env and customize for your setup

# Photobooth App Path
PHOTOBOOTH_APP_PATH=C:\Program Files\dslrBooth\dslrBooth.exe

# Pixora Payments Executable Path
PIXORA_EXE = C:\Users\pc\AppData\Local\Programs\PixoraPayments\PixoraPayments.exe

# Bridge Server Port (default: 4000)
BRIDGE_PORT=4000

# Credit TTL in seconds (default: 1800 = 30 minutes)
PIXORA_CREDIT_TTL_SEC=1800

# Enable Verbose Logs (true/false)
CLIENT_VERBOSE_LOGS=true

# Enable Inspect Server (true/false)
PIXORA_INSPECT_SERVER=true
